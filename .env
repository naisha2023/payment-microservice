# ===============================
# 🔐 SECURITY / JWT
# ===============================
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ===============================
# 🔐 GRAFANA & PROMETHEUS
# ===============================
GRAFANA_USER=admin

# ===============================
# 🗄️ DATABASE (AUTH)
# ===============================
AUTH_DB_NAME=authdb
AUTH_DB_USER=postgres
AUTH_DB_URL=jdbc:postgresql://auth-db:5432/authdb

# ===============================
# 🗄️ DATABASE (WALLET)
# ===============================
WALLET_DB_NAME=walletdb
WALLET_DB_USER=postgres
WALLET_DB_URL=jdbc:postgresql://wallet-db:5432/walletdb

# ===============================
# 🗄️ DATABASE (PAYMENT)
# ===============================
PAYMENT_DB_NAME=paymentdb
PAYMENT_DB_USER=postgres
PAYMENT_DB_URL=jdbc:postgresql://payment-db:5432/paymentdb

# ===============================
# 🐇 RABBITMQ
# ===============================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin

# ===============================
# 🌐 SERVICES (INTERNAL URLs)
# ===============================
AUTH_SERVICE_URL=https://auth-service:8081
WALLET_SERVICE_URL=https://wallet-service:8082
PAYMENT_SERVICE_URL=https://payment-service:8083
LEDGER_SERVICE_URL=http://ledger-service:8084

# ===============================
# 🚪 API GATEWAY
# ===============================
GATEWAY_PORT=8080

# ===============================
# 🧪 SPRING PROFILES
# ===============================
SPRING_PROFILES_ACTIVE=dev